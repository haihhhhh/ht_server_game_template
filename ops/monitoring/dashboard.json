{
  "title": "游戏骨架基础指标",
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "操作完成速率", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sum by (result) (rate(ht_operations_total[5m]))"}]},
    {"id": 2, "title": "操作耗时 P95", "type": "timeseries", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(ht_operation_duration_seconds_bucket[5m])))"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 3, "title": "待完成数据库任务", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "ht_save_pending"}]},
    {"id": 4, "title": "Go 堆内存", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "go_memstats_heap_alloc_bytes"}], "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}}
  ]
}
